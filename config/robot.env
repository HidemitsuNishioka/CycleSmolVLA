# SO-101 / SO-ARM101 device settings.
# Run ./scripts/detect_devices.sh first, then fill these values with the
# devices actually detected on this host. Do not assume ttyACM0/ttyACM1.

FOLLOWER_PORT="/dev/ttyACM1"
LEADER_PORT="/dev/ttyACM0"

FOLLOWER_ID="so101_follower"
LEADER_ID="so101_leader"

# Use the stable /dev/serial/by-id/* path when available.
# Camera values may be numeric OpenCV indices (e.g. 0) or paths (e.g. /dev/video1).
CAMERA_TOP_DEVICE="/dev/video1"
CAMERA_WRIST_DEVICE=""
CAMERA_WIDTH="640"
CAMERA_HEIGHT="480"
CAMERA_FPS="30"
DISPLAY_DATA="false"
