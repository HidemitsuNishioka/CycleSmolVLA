# LeRobotDataset v3 recording settings.
# Copy this file to config/dataset.local.env for machine-specific overrides.

DATASET_REPO_ID="your-hf-user/so101_quarter-fold"
DATASET_ROOT="data/so101_quarter-fold"
DATASET_TASK="Fold the cloth in half."
DATASET_NUM_EPISODES="10"
DATASET_FPS="30"
DATASET_EPISODE_TIME_S="15"
DATASET_RESET_TIME_S="10"
# Upload the completed recording session to Hugging Face automatically.
DATASET_PUSH_TO_HUB="true"
DATASET_PRIVATE="true"
DATASET_STREAMING_ENCODING="true"
DATASET_ENCODER_THREADS="2"

# The held-out fraction used by SMOLVLA training and open-loop evaluation.
DATASET_EVAL_SPLIT="0.2"

# Device used for SMOLVLA training and offline evaluation.
POLICY_DEVICE="cuda"

WANDB_ENABLE="true"
WANDB_PROJECT="lerobot-so101"
WANDB_ENTITY=""
WANDB_MODE="online"
# Keep credentials in config/dataset.local.env, which is git-ignored.
WANDB_API_KEY=""

# Hugging Face write token. Keep the real value in config/dataset.local.env.
# The recording wrapper passes it to the Docker container without putting the
# token itself in the command line or in logs.
HF_TOKEN=""

# Official LeRobot SMOLVLA base model for one connected camera.
# The current dataset key is observation.images.top; it is mapped to camera1
# because the base checkpoint has three visual slots.
SMOLVLA_BASE_PATH="lerobot/smolvla_base"
SMOLVLA_OUTPUT_DIR="outputs/train/smolvla_so101_wrist_20k_v1"
SMOLVLA_JOB_NAME="smolvla_so101_wrist_20k_v1"
SMOLVLA_STEPS="20000"
SMOLVLA_SAVE_FREQ="2000"
SMOLVLA_LOG_FREQ="100"
SMOLVLA_BATCH_SIZE="4"
SMOLVLA_NUM_WORKERS="0"
SMOLVLA_EMPTY_CAMERAS="2"
SMOLVLA_RENAME_MAP='{"observation.images.top":"observation.images.camera1"}'
SMOLVLA_CHUNK_SIZE="50"
SMOLVLA_N_ACTION_STEPS="50"
SMOLVLA_CYCLE_ENABLED="true"
SMOLVLA_CYCLE_HISTORY_SIZE="32"
SMOLVLA_CYCLE_IMAGE_HISTORY_SIZE="6"
SMOLVLA_CYCLE_PROGRESS_LOSS_WEIGHT="0.1"
SMOLVLA_USE_AMP="true"
SMOLVLA_FREEZE_VISION_ENCODER="true"
SMOLVLA_TRAIN_EXPERT_ONLY="true"
SMOLVLA_TRAIN_STATE_PROJ="true"
SMOLVLA_PUSH_TO_HUB="false"
SMOLVLA_POLICY_REPO_ID=""
SMOLVLA_POLICY_PATH="outputs/train/smolvla_so101_wrist_20k_v1/checkpoints/last/pretrained_model"
SMOLVLA_ROLLOUT_DURATION="60"

# Device used for real-robot rollout.
ROLLOUT_DEVICE="cuda"
