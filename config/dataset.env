# LeRobotDataset v3 recording settings.
# DATASET_REPO_ID is still required for local datasets as the LeRobot dataset
# identifier; set DATASET_PUSH_TO_HUB=true after `hf auth login` to upload it.

DATASET_REPO_ID="your-hf-user/so101_quarter-fold"
DATASET_ROOT="data/so101_quarter-fold"
DATASET_TASK="Fold the cloth in half."
DATASET_NUM_EPISODES="10"
DATASET_FPS="30"
DATASET_EPISODE_TIME_S="15"
DATASET_RESET_TIME_S="10"
DATASET_PUSH_TO_HUB="false"
DATASET_PRIVATE="false"
DATASET_STREAMING_ENCODING="true"
DATASET_ENCODER_THREADS="2"

# Offline open-loop evaluation uses the last fraction of episodes as a held-out set.
# This is consumed by the official lerobot-train eval_loss path.
DATASET_EVAL_SPLIT="0.2"

# Long official Diffusion Policy run. Leave DIFFUSION_PRETRAINED_PATH empty
# unless a compatible LeRobot Diffusion checkpoint is explicitly selected.
DIFFUSION_OUTPUT_DIR="outputs/train/diffusion_so101_from_scratch_20k_v1"
DIFFUSION_JOB_NAME="diffusion_so101_from_scratch_20k_v1"
DIFFUSION_STEPS="20000"
DIFFUSION_SAVE_FREQ="2000"
DIFFUSION_LOG_FREQ="100"
DIFFUSION_EVAL_STEPS="1000"
DIFFUSION_MAX_EVAL_SAMPLES="0"
DIFFUSION_BATCH_SIZE="2"
DIFFUSION_NUM_WORKERS="0"
POLICY_DEVICE="cuda"
POLICY_PUSH_TO_HUB="false"
POLICY_REPO_ID=""
WANDB_ENABLE="true"
WANDB_PROJECT="lerobot-so101"
WANDB_ENTITY=""
WANDB_MODE="online"
DIFFUSION_PRETRAINED_PATH=""
DIFFUSION_BASELINE_OUTPUT_DIR="outputs/eval/diffusion_open_loop_before_random"
DIFFUSION_BASELINE_JOB_NAME="diffusion_open_loop_before"

# Official MolmoAct2 fine-tuning from the SO-100/101 pretrained checkpoint.
# This one-camera route uses the original HF checkpoint with dataset-derived
# features, so it can fine-tune from observation.images.top only.
MOLMOACT2_CHECKPOINT_PATH="allenai/MolmoAct2-SO100_101"
MOLMOACT2_NORM_TAG="so100_so101_molmoact2"
MOLMOACT2_OUTPUT_DIR="outputs/train/molmoact2_so101_top_20k_v1"
MOLMOACT2_JOB_NAME="molmoact2_so101_top_20k_v1"
MOLMOACT2_STEPS="20000"
MOLMOACT2_SAVE_FREQ="2000"
MOLMOACT2_LOG_FREQ="20"
MOLMOACT2_BATCH_SIZE="1"
MOLMOACT2_NUM_WORKERS="0"
MOLMOACT2_TRAIN_MODE_VLM="freeze"
MOLMOACT2_DTYPE="bfloat16"
MOLMOACT2_GRADIENT_CHECKPOINTING="true"
MOLMOACT2_COMPILE_MODEL="false"
MOLMOACT2_ACTION_MODE="continuous"
MOLMOACT2_INFERENCE_ACTION_MODE="continuous"
MOLMOACT2_CHUNK_SIZE="10"
MOLMOACT2_N_ACTION_STEPS="10"
MOLMOACT2_NUM_FLOW_TIMESTEPS="8"
MOLMOACT2_IMAGE_KEYS='["observation.images.top"]'
MOLMOACT2_SETUP_TYPE="single SO-101 follower arm"
MOLMOACT2_CONTROL_MODE="absolute joint pose"
# Required when loading the original HF SO-100/101 checkpoint with current
# LeRobot calibration conventions. The converted LeRobot checkpoint already
# carries this correction internally.
MOLMOACT2_JOINT_SIGNS="[1,-1,1,1,1,1]"
MOLMOACT2_JOINT_OFFSETS="[0,90,90,0,0,0]"
MOLMOACT2_PUSH_TO_HUB="false"
MOLMOACT2_POLICY_REPO_ID=""
MOLMOACT2_POLICY_PATH="outputs/train/molmoact2_so101_top_20k_v1/checkpoints/last/pretrained_model"
MOLMOACT2_ROLLOUT_DURATION="60"

# Official SmolVLA base model for a single connected camera.
# The base checkpoint has three visual slots; empty_cameras=2 masks the two
# unavailable slots and rename_map maps this dataset's top key to camera1.
SMOLVLA_BASE_PATH="lerobot/smolvla_base"
SMOLVLA_OUTPUT_DIR="outputs/train/smolvla_so101_wrist_20k_v1"
SMOLVLA_JOB_NAME="smolvla_so101_wrist_20k_v1"
SMOLVLA_STEPS="20000"
SMOLVLA_SAVE_FREQ="2000"
SMOLVLA_LOG_FREQ="100"
SMOLVLA_BATCH_SIZE="4"
SMOLVLA_NUM_WORKERS="0"
SMOLVLA_EMPTY_CAMERAS="2"
SMOLVLA_RENAME_MAP='{"observation.images.top":"observation.images.camera1"}'
SMOLVLA_CHUNK_SIZE="50"
SMOLVLA_N_ACTION_STEPS="50"
SMOLVLA_USE_AMP="true"
SMOLVLA_FREEZE_VISION_ENCODER="true"
SMOLVLA_TRAIN_EXPERT_ONLY="true"
SMOLVLA_TRAIN_STATE_PROJ="true"
SMOLVLA_PUSH_TO_HUB="false"
SMOLVLA_POLICY_REPO_ID=""
SMOLVLA_POLICY_PATH="outputs/train/smolvla_so101_wrist_20k_v1/checkpoints/last/pretrained_model"
SMOLVLA_ROLLOUT_DURATION="60"

# Set this to a specific checkpoint directory when needed. The default points
# at the final local checkpoint generated by lerobot-train.
POLICY_PATH="outputs/train/diffusion_so101_from_scratch_20k_v1/checkpoints/last/pretrained_model"
ROLLOUT_DEVICE="cuda"
ROLLOUT_DURATION="60"


# Put a newly issued key in config/dataset.local.env instead. The previous key
# was exposed in a diagnostic transcript and must be revoked/rotated.
WANDB_API_KEY=""
