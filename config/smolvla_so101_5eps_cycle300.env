# Use with SO101_DATASET_CONFIG=config/smolvla_so101_5eps_cycle300.env
# Despite its directory name, this local dataset contains 10 episodes.
DATASET_REPO_ID="Hidemitsu-Nishioka/so101_5eps"
DATASET_ROOT="data/so101_5eps"
DATASET_TASK="Pick up the object and place it in the target area"
DATASET_FPS="30"
DATASET_EVAL_SPLIT="0.2"
SMOLVLA_BASE_PATH="lerobot/smolvla_base"
SMOLVLA_OUTPUT_DIR="outputs/train/smolvla_so101_5eps_cycle300"
SMOLVLA_JOB_NAME="smolvla_so101_5eps_cycle300"
POLICY_DEVICE="cuda"
SMOLVLA_STEPS="20000"
# Limit checkpoint storage on the host: save four checkpoints in this run.
SMOLVLA_SAVE_FREQ="5000"
SMOLVLA_LOG_FREQ="20"
SMOLVLA_BATCH_SIZE="4"
SMOLVLA_NUM_WORKERS="0"
SMOLVLA_EVAL_STEPS="2000"
SMOLVLA_MAX_EVAL_SAMPLES="100"
SMOLVLA_CYCLE_ENABLED="true"
SMOLVLA_CYCLE_HISTORY_SIZE="300"
SMOLVLA_CYCLE_IMAGE_HISTORY_SIZE="6"
SMOLVLA_CYCLE_PROGRESS_LOSS_WEIGHT="0.1"
SMOLVLA_CHUNK_SIZE="50"
SMOLVLA_N_ACTION_STEPS="50"
SMOLVLA_RENAME_MAP='{"observation.images.top":"observation.images.camera1"}'
SMOLVLA_EMPTY_CAMERAS="2"
SMOLVLA_USE_AMP="true"
SMOLVLA_FREEZE_VISION_ENCODER="true"
SMOLVLA_TRAIN_EXPERT_ONLY="true"
SMOLVLA_TRAIN_STATE_PROJ="true"
SMOLVLA_PUSH_TO_HUB="false"
WANDB_ENABLE="true"
WANDB_MODE="online"
WANDB_PROJECT="lerobot-so101"
