# Use with SO101_DATASET_CONFIG=config/smolvla_shake_cup_3times_300.env
DATASET_REPO_ID="Hidemitsu-Nishioka/so101_shake_cup_3times"
DATASET_ROOT="data/so101_shake_cup_3times"
DATASET_TASK="Shake the cup three times."
DATASET_FPS="30"
DATASET_EVAL_SPLIT="0.2"
SMOLVLA_BASE_PATH="lerobot/smolvla_base"
SMOLVLA_OUTPUT_DIR="outputs/train/smolvla_shake_cup_3times_cycle300"
SMOLVLA_JOB_NAME="smolvla_shake_cup_3times_cycle300"
SMOLVLA_STEPS="20000"
SMOLVLA_SAVE_FREQ="2000"
SMOLVLA_LOG_FREQ="100"
SMOLVLA_BATCH_SIZE="4"
SMOLVLA_NUM_WORKERS="0"
SMOLVLA_EVAL_STEPS="2000"
SMOLVLA_MAX_EVAL_SAMPLES="100"
SMOLVLA_CYCLE_ENABLED="true"
# Current frame and preceding 299 frames, sampled at 30 Hz.
SMOLVLA_CYCLE_HISTORY_SIZE="300"
SMOLVLA_CYCLE_IMAGE_HISTORY_SIZE="6"
SMOLVLA_CYCLE_PROGRESS_LOSS_WEIGHT="0.1"
SMOLVLA_CHUNK_SIZE="50"
SMOLVLA_N_ACTION_STEPS="50"
SMOLVLA_PUSH_TO_HUB="false"
# Checkpoint selected for real-robot rollout.
SMOLVLA_POLICY_PATH="outputs/train/smolvla_shake_cup_3times_cycle300/016000"
CYCLEMANIP_CHECKPOINT="outputs/train/smolvla_shake_cup_3times_cycle300/016000"
CYCLEMANIP_TASK="Shake the cup three times."
CYCLEMANIP_DURATION="60"
